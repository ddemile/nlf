let t = [10, 4, 8, 5, 2]

fn move(t, a, b) {
    let tmp = t[a]
    t[a] = t[b]
    t[b] = tmp
}

fn sort(t) {
    for i in ..t.len() {
        let m = i
        for j in i..t.len() {
            if t[j] < t[m] {
                m = j
            }
        }
        move(t, i, m)
    }
}

sort(t)
for i in ..t.len() {
    print(t[i])
}