import {mutate_key, concat} from "./program.nlf"

let store = {
    key: "Default value"
}

export fn get_key() {
    return store.key
}

export fn increment_key() {
    mutate_key(store, store.key + 1)
}

export fn set_key(value) {
    store.key = value
}

export fn greet(name) {
    return concat("Hello", name)
}