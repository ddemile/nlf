// Name: Slow fibonacci implementation
fn fib_slow(n) {
    if n <= 1 {
        return n
    } else {
        return fib_slow(n - 1) + fib_slow(n - 2)
    }
}

assert(fib_slow(20) == 6765)

// Name: Fast fibonacci implementation
fn fib_fast(n) {
    let a = 1
    let b = 1
    for i in 3..(n + 1) {
        let c = a + b
        a = b
        b = c
    }
    return b
}

assert(fib_fast(20) == 6765)