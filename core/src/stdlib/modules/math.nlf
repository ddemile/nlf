let math = binding("math")

export fn sqrt(x) {
    return math.sqrt(x)
}

export fn pow(a, b) {
    return math.pow(a, b)
}

export fn abs(x) {
    return math.abs(x)
}

export fn sign(x) {
    return math.sign(x)
}

export fn sin(x) {
    return math.sin(x)
}

export fn cos(x) {
    return math.cos(x)
}

export fn tan(x) {
    return math.tan(x)
}

export fn round(x) {
    return math.round(x)
}

export fn floor(x) {
    return math.floor(x)
}

export fn ceil(x) {
    return math.ceil(x)
}

export fn pi() {
    return math.pi()
}

export fn min(a, b) {
    return math.min(a, b)
}

export fn max(a, b) {
    return math.max(a, b)
}