import { sin, cos, min } from "core:math"
import { App, RendererContext } from "./papangue.nlf"

export fn launch() {
    let app = App()

    let window = app.create_window("My engine window")

    let value = 0;

    window.set_clear_color([135 / 255, 206 / 255, 250 / 255])

    let count = 50

    let pos = [0, 500]

    let velocity = [0, 0]

    let grounded = true

    window.set_draw_callback((context: RendererContext, delta_time: number) => {
        let window_size = window.get_size()

        if context.btn("A") {
            pos[0] -= 2
        }

        if context.btn("D") {
            pos[0] += 2
        }

        if context.btn("Space") && grounded {
            velocity[1] -= 5
            grounded = false
        }

        if !grounded {
            velocity[1] += 0.08
        }

        pos[1] += velocity[1]

        if pos[1] > 500 {
            pos[1] = 500
            velocity[1] = 0
            grounded = true
        }

        context.draw_rect([0, 0], [100, 100], [0.5, 0, 0])

        context.draw_rect(pos, [100, 100], [0.5, 0.5, 1])
        context.draw_rect([0, 500 + 100], [window_size[0] * 2, window_size[1] + 600], [0.7, 1, 0.6])

        context.draw_rect([context.mouse_pos()[0] * 2 - 8, context.mouse_pos()[1] * 2 - 8], [16, 16], [1, 1, 1])
    })

    app.run()
}