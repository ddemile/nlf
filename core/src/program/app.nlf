import { sin, cos } from "core:math"
import { App, RendererContext } from "./papangue.nlf"

export fn launch() {
    let app = App()

    let window = app.create_window("My engine window")

    let window2 = app.create_window("My engine window")

    let value = 0;

    window.set_clear_color([0, 0, 0])

    window2.set_draw_callback((context: RendererContext, _) => {
        context.draw_rect([100, 100], [100, (sin(value) + 1) / 2 * 500], [0.5, 0.5, 1])
    })

    let count = 50

    window.set_draw_callback((context: RendererContext, delta_time: number) => {
        let window_size = window.get_size()

        let size_vec = [(sin(value) + 1) * window_size[0] / 4, (sin(value) + 1) * window_size[1] / 4]

        window2.set_clear_color([(sin(value) + 1) / 2, 1, 1])
        
        value += (2 * π) * delta_time

        value %= 2 * π

        let r = (cos(value) + 1) / 2;
        
        let color = [0, 1, 0.5]
        
        context.draw_rect([0, 0], size_vec, [0.6, 0.6, 0.6])

        for i in 0..count {
            size_vec[0] = 800 + i * 10 + (cos(value + 2 * π) + 1) * 100

            let wave = (cos(value + 2 * π * (i / count)) + 1) / 2;
            let wave2 = (sin(value + 2 * π * (i / count)) + 1) / 2;

            size_vec[1] = wave * 100 + 100
            context.draw_rect(size_vec, [10, 10], [wave, 1, 1])
        }
    })

    app.run()
}