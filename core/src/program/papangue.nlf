let native_addon = addon("/home/ddemile/Documents/Programming/Rust/papangue-bindings/target/release/libpapangue_bindings.so")

let last_time: number = now()
let total = 0
let samples = 0

export class RendererContext {
    RendererContext(handle: number, behaviour_handle: number) {
        self.handle = handle
        self.behaviour_handle = behaviour_handle
        self.size = 50
        self.keys = []
        self.mouse_position = [0, 0]
    }

    fn draw_rect(self, pos, size, color) {
        native_addon.draw_shape(self.behaviour_handle, "rectangle", pos[0], pos[1], size[0], size[1], color[0], color[1], color[2])
    }

    fn btnp(self, key: string): bool {
        for i in 0..self.keys.len() {
            if self.keys[i][0] == key {
                return self.keys[i][1] == 1
            }
        }

        return false
    }

    fn btn(self, key: string): bool {
        for i in 0..self.keys.len() {
            if self.keys[i][0] == key {
                return true
            }
        }

        return false
    }

    fn btnr(self, key: string): bool {
        for i in 0..self.keys.len() {
            if self.keys[i][0] == key {
                return self.keys[i][1] == 3
            }
        }

        return false
    }

    fn mouse_pos(self): any {
        return self.mouse_position
    }
}

export class Window {
    Window(handle: number, app_handle: number) {
        self.handle = handle
        self.app_handle = app_handle
        self.renderer_context = RendererContext(native_addon.get_renderer_handle(handle), native_addon.get_behaviour_handle(handle))
    }

    fn set_draw_callback(self, callback) {
        native_addon.set_draw_callback(self.renderer_context.behaviour_handle, (delta_time, keys, mouse_position) => {
            self.renderer_context.keys = keys
            self.renderer_context.mouse_position = mouse_position
            // let start = now()
            callback(self.renderer_context, delta_time)
            // let end = now()
            // total += end - start
            // samples += 1
            // if end - last_time > 1000 {
            //     print("Average time per frame:", total / samples)
            //     last_time = end
            //     total = 0
            //     samples = 0
            // }
        })
    }

    fn get_size(self) {
        return [native_addon.get_window_width(self.handle), native_addon.get_window_height(self.handle)]
    }

    fn set_clear_color(self, color) {
        native_addon.set_clear_color(self.renderer_context.handle, color[0], color[1], color[2])
    }
}

export class App {
    App() {
        self.handle = native_addon.create_app()
    }

    fn create_window(self, title): Window {
        let window_handle = native_addon.create_window(self.handle, title)

        return Window(window_handle, self.handle)
    }

    fn run(self) {
        native_addon.run_app(self.handle)
    }
}