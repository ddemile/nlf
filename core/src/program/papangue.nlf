let native_addon = addon("C:/Users/emili/Documents/Programmation/Rust/papangue-bindings/target/release/papangue_bindings.dll")

class RendererContext {
    RendererContext(handle, behaviour_handle) {
        self.handle = handle
        self.behaviour_handle = behaviour_handle
        self.size = 50
    }

    fn draw_rect(pos, size, color) {
        native_addon.draw_shape(self.behaviour_handle, "rectangle", pos[0], pos[1], size[0], size[1], color[0], color[1], color[2])
    }
}

class Window {
    Window(handle, app_handle) {
        self.handle = handle
        self.app_handle = app_handle
        self.renderer_context = RendererContext(native_addon.get_renderer_handle(handle), native_addon.get_behaviour_handle(handle))
    }

    fn set_draw_callback(callback) {
        native_addon.set_draw_callback(self.renderer_context.behaviour_handle, (delta_time) => {
            callback(self.renderer_context, delta_time)
        })
    }

    fn get_size() {
        return [native_addon.get_window_width(self.handle), native_addon.get_window_height(self.handle)]
    }

    fn set_clear_color(color) {
        native_addon.set_clear_color(self.renderer_context.handle, color[0], color[1], color[2])
    }
}

export class App {
    App() {
        self.handle = native_addon.create_app()
    } 

    fn create_window(title) {
        let window_handle = native_addon.create_window(self.handle, title)

        return Window(window_handle, self.handle)
    }

    fn run() {
        native_addon.run_app(self.handle)
    }
}