// Name: Slow search algorithm implementation
fn search_slow(lst, value) {
    for i in 0..lst.len() {
        if lst[i] == value {
            return i
        }
    }
}

assert(search_slow([
    0,1,2,3,3,4,4,5,6,8,9,11,12,14,15,17,18,18,19,20,20,21,21,21,22,23,24,27,28,29,31,35,36,37,38,38,38,39,40,40,41,41,41,42,42,42,43,44,46,48,50,51,52,54,54,55,55,56,56,56,58,59,61,61,61,61,62,63,63,64,66,66,67,68,69,69,72,74,76,76,79,80,81,82,82,82,83,85,85,88,91,92,93,95,95,96,96,98,99,99
], 80) == 81)

// Name: Fast search algorithm implementation
let math = binding("math");

fn search_fast(lst, value) {
    let left = 0;
    let right = lst.len() - 1;

    while left < right {
        let middle = math.floor((left + right) / 2);

        if value == lst[middle] {
            left = middle
            right = middle
        } else if value < lst[middle] {
            right = middle - 1
        } else {
            left = middle + 1
        }
    }

    if value == lst[left] {
        return left
    }
}

assert(search_fast([
    0,1,2,3,3,4,4,5,6,8,9,11,12,14,15,17,18,18,19,20,20,21,21,21,22,23,24,27,28,29,31,35,36,37,38,38,38,39,40,40,41,41,41,42,42,42,43,44,46,48,50,51,52,54,54,55,55,56,56,56,58,59,61,61,61,61,62,63,63,64,66,66,67,68,69,69,72,74,76,76,79,80,81,82,82,82,83,85,85,88,91,92,93,95,95,96,96,98,99,99
], 80) == 81)